density_df <- data.frame(x = density_data$x, y = density_data$y)
# Step 4: Mark inside vs outside regions
density_df <- density_df %>%  mutate(region = ifelse(x >= lower_cutoff & x <= upper_cutoff, "inside", "outside"))
#Insert exact cutoff points into density data to ensure complete fill
cutoff_points <- data.frame(x = c(lower_cutoff, upper_cutoff), y = approx(density_df$x, density_df$y, xout = c(lower_cutoff, upper_cutoff))$y,region = "inside")
density_df <- rbind(density_df, cutoff_points) %>% arrange(x)
# Step 5: Plot  #🔴edit on labs title
max_coverage <- max(simulated_values, na.rm = TRUE) #calculate max coverage value
ggplot(density_df, aes(x = x, y = y)) +
geom_line(color = "black", size = 0.7) +
geom_area(data = filter(density_df, region == "inside"), fill = "#00B050", alpha = .8) +
geom_vline(xintercept = c(lower_cutoff, upper_cutoff), color = "red", linetype = "dashed") +
annotate("text", x = lower_cutoff, y = 0.01, label = paste0("2.5% = ", round(lower_cutoff, 2)),
color = "white", size = 3, hjust = 0) +
annotate("text", x = upper_cutoff, y = 0.01, label = paste0("97.5% = ", round(upper_cutoff, 2)),
color = "black", size = 3, hjust = -0.2) +
labs(title = expression(italic("Vigna radiata")~ "(NUPTs)"), x = "Coverage", y = "Density") +
theme_classic(base_size = 14, base_family = "Times New Roman") +
theme(
plot.title = element_text(hjust = 0.5, face = "italic", size = 16, margin = margin(b = 15)),
axis.title.x = element_text(margin = margin(t = 10)),
axis.title.y = element_text(margin = margin(r = 10)),
axis.text = element_text(color = "black"),
axis.line.x.top = element_blank(),      #remove top x-axis line
axis.ticks.x.top = element_blank(),     #remove top ticks
axis.text.x.top = element_blank()       #remove top labels
) +
scale_x_break(c(350, max_coverage * 0.9), scales = 0.5) +
scale_x_continuous(
expand = expansion(mult = c(0.01, 0.01)),
labels = label_number(scale_cut = cut_short_scale())
)
# Step 6: Flagging start/stop values against the global cutoff
df$start_flag <- ifelse(df$nupts_start_region < lower_cutoff | df$nupts_start_region > upper_cutoff, "-", "+")
df$stop_flag  <- ifelse(df$nupts_stop_region < lower_cutoff | df$nupts_stop_region > upper_cutoff, "-", "+")
# Step 7: Mark Possible Artifact or Authentic
df$check_status <- ifelse(df$start_flag == "+" & df$stop_flag == "+", "Authentic", "Possible Artifact")
# Step 8: Count Authentic and Artifact rows
authentic_count <- sum(df$check_status == "Authentic")
artifact_count  <- sum(df$check_status == "Possible Artifact")
print(paste("Authentic count:", authentic_count))
print(paste("Possible Artifact count:", artifact_count))
# Step 8.1: Add summary counts ONLY to the second row
df$authentic_count <- ""
df$artifact_count <- ""
df$authentic_count[1] <- authentic_count
df$artifact_count[1] <- artifact_count
# Step 9: Save results  #🔴edit
write_csv(df, "Vigna_nupts_outlier_results.csv")
ggsave("Vigna_nupts_outlier.png", width = 6, height = 4, dpi = 300)
setwd("D:/NUMT/R Analysis/Vigna radiata")
# Load necessary libraries
library(readr)
library(tidyverse)
library(ggbreak)
library(scales)
# Read the data  #🔴edit
df <- read_csv("nupts_assembled_columns_Vigna.csv")
# Step 1: Combine all simulated values (columns 3 to 1002) into one vector
simulated_values <- unlist(df[, 3:1002])
simulated_values <- as.numeric(simulated_values)  # Ensure numeric
# Step 2: Calculate 2.5% and 97.5% cutoffs
lower_cutoff <- quantile(simulated_values, probs = 0.025, na.rm = TRUE)
upper_cutoff <- quantile(simulated_values, probs = 0.975, na.rm = TRUE)
# Step 3: Calculate density and prepare data for plotting
density_data <- density(simulated_values, na.rm = TRUE)
density_df <- data.frame(x = density_data$x, y = density_data$y)
# Step 4: Mark inside vs outside regions
density_df <- density_df %>%  mutate(region = ifelse(x >= lower_cutoff & x <= upper_cutoff, "inside", "outside"))
#Insert exact cutoff points into density data to ensure complete fill
cutoff_points <- data.frame(x = c(lower_cutoff, upper_cutoff), y = approx(density_df$x, density_df$y, xout = c(lower_cutoff, upper_cutoff))$y,region = "inside")
density_df <- rbind(density_df, cutoff_points) %>% arrange(x)
# Step 5: Plot  #🔴edit on labs title
max_coverage <- max(simulated_values, na.rm = TRUE) #calculate max coverage value
ggplot(density_df, aes(x = x, y = y)) +
geom_line(color = "black", size = 0.7) +
geom_area(data = filter(density_df, region == "inside"), fill = "#00B050", alpha = .8) +
geom_vline(xintercept = c(lower_cutoff, upper_cutoff), color = "red", linetype = "dashed") +
annotate("text", x = lower_cutoff, y = 0.01, label = paste0("2.5% = ", round(lower_cutoff, 2)),
color = "black", size = 3, hjust = 0) +
annotate("text", x = upper_cutoff, y = 0.01, label = paste0("97.5% = ", round(upper_cutoff, 2)),
color = "black", size = 3, hjust = -0.2) +
labs(title = expression(italic("Vigna radiata")~ "(NUPTs)"), x = "Coverage", y = "Density") +
theme_classic(base_size = 14, base_family = "Times New Roman") +
theme(
plot.title = element_text(hjust = 0.5, face = "italic", size = 16, margin = margin(b = 15)),
axis.title.x = element_text(margin = margin(t = 10)),
axis.title.y = element_text(margin = margin(r = 10)),
axis.text = element_text(color = "black"),
axis.line.x.top = element_blank(),      #remove top x-axis line
axis.ticks.x.top = element_blank(),     #remove top ticks
axis.text.x.top = element_blank()       #remove top labels
) +
scale_x_break(c(350, max_coverage * 0.9), scales = 0.5) +
scale_x_continuous(
expand = expansion(mult = c(0.01, 0.01)),
labels = label_number(scale_cut = cut_short_scale())
)
# Step 6: Flagging start/stop values against the global cutoff
df$start_flag <- ifelse(df$nupts_start_region < lower_cutoff | df$nupts_start_region > upper_cutoff, "-", "+")
df$stop_flag  <- ifelse(df$nupts_stop_region < lower_cutoff | df$nupts_stop_region > upper_cutoff, "-", "+")
# Step 7: Mark Possible Artifact or Authentic
df$check_status <- ifelse(df$start_flag == "+" & df$stop_flag == "+", "Authentic", "Possible Artifact")
# Step 8: Count Authentic and Artifact rows
authentic_count <- sum(df$check_status == "Authentic")
artifact_count  <- sum(df$check_status == "Possible Artifact")
print(paste("Authentic count:", authentic_count))
print(paste("Possible Artifact count:", artifact_count))
# Step 8.1: Add summary counts ONLY to the second row
df$authentic_count <- ""
df$artifact_count <- ""
df$authentic_count[1] <- authentic_count
df$artifact_count[1] <- artifact_count
# Step 9: Save results  #🔴edit
write_csv(df, "Vigna_nupts_outlier_results.csv")
ggsave("Vigna_nupts_outlier.png", width = 6, height = 4, dpi = 300)
